{
  "build": [
    "sh",
    "-c",
    "SECRET_KEY_BASE_DUMMY=1 RAILS_ENV=production bin/rails assets:precompile"
  ],
  "check": [
    "sh",
    "-c",
    "bin/rubocop && bin/brakeman --quiet --no-pager --exit-on-warn --exit-on-error"
  ],
  "setup": [
    "sh",
    "-c",
    "bin/pg install && bin/pg start && bin/setup --skip-server"
  ],
  "test": [
    "sh",
    "-c",
    "bin/pg start && bin/rails test"
  ]
}
